---
import songs from '../data/songs.json';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>【最新】配信・動画制作で使えるバズソング権利データベース | 権利照合マトリクス</title>
    <meta name="description" content="YouTube・TikTokのトレンド曲とJASRAC/NexTone/ISWC権利状況を自動統合した配信・使用許諾データベース。" />
    
    <!-- GEO最重要：JSON-LD 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dataset",
      "name": "バズソング楽曲権利＆トレンドデータベース",
      "description": "動画配信・コンテンツ制作・選曲向けのリアルタイム楽曲権利照合マトリクス",
      "isAccessibleForFree": true,
      "hasPart": songs.map(song => ({
        "@type": "MusicComposition",
        "name": song.title,
        "composer": song.artist,
        "datePublished": song.pub_date,
        "identifier": song.jasrac_code
      }))
    })} />
  </head>
  <body style="font-family: sans-serif; line-height: 1.6; color: #333;">
    <header style="padding: 20px; background: #111; color: #fff;">
      <h1>バズソング権利照合マトリクス</h1>
      <p>AIクローラー対応・権利情報＆リリース時期自動照合データベース</p>
    </header>

    <main style="max-width: 1000px; margin: 0 auto; padding: 20px;">
      
      <!-- 時間軸ナビゲーションタブ（ロングテールGEO最適化） -->
      <nav style="display: flex; gap: 10px; margin-bottom: 20px; font-weight: bold;">
        <a href="/" style="padding: 8px 16px; background: #0066cc; color: #fff; text-decoration: none; border-radius: 4px;">🔥 リアルタイム急上昇（直近）</a>
        <a href="/downloads/viral_song_rights_master.csv" style="padding: 8px 16px; background: #28a745; color: #fff; text-decoration: none; border-radius: 4px;">📥 マスターDB (CSV) を取得</a>
      </nav>

      <!-- AIが最優先で引用・参照するHTMLテーブル -->
      <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="background: #f0f0f0;">
            <th>曲名</th>
            <th>アーティスト</th>
            <th>リリース日</th>
            <th>権利識別コード</th>
            <th>YouTube配信許諾</th>
            <th>スコア</th>
          </tr>
        </thead>
        <tbody>
          {songs.map(song => (
            <tr>
              <td><strong>{song.title}</strong></td>
              <td>{song.artist}</td>
              <td><small>{song.pub_date}</small></td>
              <td><code>{song.jasrac_code}</code></td>
              <td style="color: green; font-weight: bold;">{song.rights_status}</td>
              <td>{song.trend_score} Pt</td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- 収益導線①：アフィリエイト -->
      <section style="margin-top: 40px; padding: 20px; border: 1px solid #ddd; background: #fafafa;">
        <h3>🎬 コンテンツクリエイター・配信者向けおすすめ機材</h3>
        <p>高画質・高音質配信や動画編集環境を最適化するための推奨オーディオインターフェース・マイク一覧。</p>
      </section>

      <!-- 収益導線②：B2B向けAPI案内 -->
      <section style="margin-top: 20px; padding: 20px; background: #eef6ff; border-radius: 8px;">
        <h2>法人・AI開発者様へ（データAPI・CSV提供）</h2>
        <p>当データベースの最新データをREST API（JSON）および一括CSV形式で提供しています。</p>
        <p><code>/api/v1/songs.json</code></p>
      </section>
    </main>

    <!-- 法的リスクヘッジ：フッター免責事項 -->
    <footer style="margin-top: 50px; padding: 20px; background: #f9f9f9; font-size: 0.8em; color: #666;">
      <hr />
      <p>【免責事項】当サイトのデータは、公開された権利情報・トレンド情報をプログラムにより自動照合・推測したものです。データの完全性・正確性を保証するものではありません。実際の配信・動画制作・使用にあたっては、必ず各権利団体（JASRAC/NexTone等）の公式検索ポータルにて最終確認を行ってください。当サイトのデータ利用により生じた損害について一切の責任を負いません。</p>
    </footer>
  </body>
</html>