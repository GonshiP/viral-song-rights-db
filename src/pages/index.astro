---
import rawSongs from '../data/songs.json';
import rawHistoryIndex from '../data/history_index.json';

interface SongMetrics { views?: number; likes?: number; comments?: number; engagement_rate?: number; daily_views?: number; }
interface MetricsHistory { date: string; views?: number; likes?: number; comments?: number; engagement_rate?: number; daily_views?: number; }
interface Song {
  title: string; 
  artist: string; 
  video_url?: string;
  jasrac_search_title?: string;
  jasrac_search_artist?: string;
  jasrac_code: string; 
  rights_status: string; 
  pub_date: string;
  source_name: string; 
  source_url: string; 
  karaoke_search_url?: string;
  verified_at: string; 
  valid_until: string; 
  trend_score?: number; 
  metrics?: SongMetrics;
  metrics_history?: MetricsHistory[];
  raw_youtube?: Record<string, any>;
}

interface HistoryIndexEntry { date: string; count: number; path: string; }

const songs = rawSongs as Song[];
const historyIndex = rawHistoryIndex as HistoryIndexEntry[];

const getSeasonTag = (d: string) => {
  const m = parseInt(d?.split('-')[1] || '0', 10);
  return !m ? '定番' : `${d.split('-')[0]}年${[3,4,5].includes(m) ? '春' : [6,7,8].includes(m) ? '夏' : [9,10,11].includes(m) ? '秋' : '冬'}`;
};

const getBadgeClass = (s: string) => {
  if (!s) return 'badge-neutral';
  if (s.includes('ISWCコード確認済み')) return 'badge-success';
  if (s.includes('iTunesで公式表記確認済み')) return 'badge-info';
  return 'badge-warning';
};

const specItems = [
  { title: 'データ収集', desc: 'YouTube Data API v3（JP/Music急上昇）と Google Gemini API（Web検索連動）によるリアルタイム抽出。' },
  { title: 'メタデータ照合', desc: 'MusicBrainz Open Registry（ISWC識別子）および iTunes Search API による公式補正。' },
  { title: '権利判定ロジック', desc: 'ISWCコード未特定の楽曲を「手動検索を推奨」に自動フォールバックさせる厳格な判定アルゴリズム。' },
  { title: '原盤権対策', desc: '著作権（作詞・作曲）と原盤権（音源）の分離管理および歌枠利用可能カラオケ音源の検索導線提供。' },
  { title: 'ライフサイクル管理', desc: '検証タイムスタンプの記録および90日間の再検証推奨期限の自動算出。' }
];

const affiliateItems = [
  { title: 'オーディオインターフェース', desc: 'ループバック機能および標準入力に対応した配信・録音用機材。', url: 'https://example.com/affiliate-link-1' },
  { title: 'コンデンサーマイクロフォン', desc: '広帯域周波数特性を備えたボーカル・音源収音用マイク。', url: 'https://example.com/affiliate-link-2' }
];

// グラフ用データ構造を構築（最大10曲を抽出）
const chartSongs = songs.slice(0, 10);
const chartData = JSON.stringify(chartSongs.map(s => ({
  title: s.jasrac_search_title || s.title,
  artist: s.jasrac_search_artist || s.artist,
  history: (s.metrics_history || []).sort((a, b) => a.date.localeCompare(b.date))
})));
const historyDates = JSON.stringify(historyIndex.map(h => h.date));

const jsonLdData = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "トレンドソング権利 ＆ トレンドアナリティクスデータベース",
  "description": "一次ソースURL・確認日時・有効期限・原盤権対策リンクを含む、楽曲権利照合およびエンゲージメント指標の統合マトリクス。",
  "isAccessibleForFree": true,
  "hasPart": songs.map(s => ({
    "@type": "MusicComposition", "name": s.title, "composer": s.artist, "datePublished": s.pub_date,
    "identifier": s.jasrac_code, "sameAs": s.source_url, "sdDatePublished": s.verified_at,
    "interactionStatistic": [
      { "@type": "InteractionCounter", "interactionType": "https://schema.org/WatchAction", "userInteractionCount": s.metrics?.views ?? 0 },
      { "@type": "InteractionCounter", "interactionType": "https://schema.org/LikeAction", "userInteractionCount": s.metrics?.likes ?? 0 }
    ]
  }))
};
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>トレンドソング権利 ＆ トレンドアナリティクスDB</title>
    <meta name="description" content="リアルタイムのトレンド楽曲動向、権利識別コード、一次ソースURL、原盤権対策リンク、エンゲージメント指標を自動集約したデータベース。" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />
  </head>
  <body>
    
    <header class="site-header">
      <div class="header-inner">
        <h1>📊 トレンドソング権利 ＆ アナリティクスDB</h1>
        <p>一次ソースエビデンス・確認日時・原盤権対策リンク付き メタデータ統合マトリクス</p>
        <div class="header-badges">
          <span class="hbadge">🤖 Gemini AI 解析</span>
          <span class="hbadge">🎵 MusicBrainz 照合</span>
          <span class="hbadge">📅 日次自動更新</span>
          <span class="hbadge">🗂️ {historyIndex.length}日分 履歴</span>
        </div>
      </div>
    </header>

    <main class="main-container">
      
      <nav class="nav-links" aria-label="主要機能ナビゲーション">
        <a href="/" class="btn btn-primary">📈 リアルタイム・トレンド分析</a>
        <a href="/downloads/viral_song_rights_master.csv" class="btn btn-success">📥 マスターDB (CSV) エクスポート</a>
        <a href="/api/v1/history.json" class="btn btn-outline" target="_blank" rel="noopener noreferrer">🗂️ 履歴 API</a>
      </nav>

      <!-- ★ グラフィカルデータ推移セクション -->
      <section class="card chart-section" id="trend-chart-section">
        <div class="chart-header">
          <h2>📊 データ推移グラフィカル分析</h2>
          <p class="chart-subtitle">日次DB更新ごとに蓄積された再生数・エンゲージメント率の時系列推移を可視化</p>
        </div>

        <div class="chart-controls">
          <div class="control-group">
            <label for="metric-selector">📈 指標選択</label>
            <select id="metric-selector" class="chart-select">
              <option value="views">再生数</option>
              <option value="engagement_rate">エンゲージメント率 (%)</option>
              <option value="daily_views">日速 (推定日次再生数)</option>
              <option value="likes">いいね数</option>
            </select>
          </div>
          <div class="control-group">
            <label for="song-filter">🎵 楽曲フィルタ</label>
            <select id="song-filter" class="chart-select">
              <option value="all">全楽曲 (トップ10)</option>
            </select>
          </div>
        </div>

        <div class="chart-wrapper">
          <canvas id="trendChart" aria-label="楽曲トレンドグラフ" role="img"></canvas>
        </div>

        <div class="history-info">
          <span class="history-label">📅 蓄積履歴日数:</span>
          {historyIndex.map(h => (
            <span class="history-chip">{h.date} ({h.count}件)</span>
          ))}
        </div>
      </section>

      <!-- システム仕様 -->
      <section class="card spec-card">
        <h3>⚙️ システム仕様およびデータ生成パイプラインについて</h3>
        <p>当データベースは、GitHub Actions による日次自動パイプライン（Gemini AI × MusicBrainz × iTunes）に基づき生成されています。</p>
        <ul>
          {specItems.map(item => <li><strong>{item.title}:</strong> {item.desc}</li>)}
        </ul>
      </section>

      <!-- 信頼性証明 (E-E-A-T) ＆ 原盤権注意書き -->
      <section class="card notice-card">
        <h3>🛡️ データ信頼性および原盤権（カラオケ音源）に関する重要な注意事項</h3>
        <p><strong>【MusicBrainz レジストリについて】</strong><br />
        当システムが参照する <strong>MusicBrainz</strong> は、MetaBrainz Foundationが運営する国際的なオープン音楽データベースであり、国際標準音源識別コード（ISWC）の追跡において高い信頼性を備えています。</p>
        <p><strong>【原盤権（音源）の注意】</strong><br />
        ステータスが「OK」と表示されている場合でも、それは<strong>「作詞・作曲の権利（著作権）」</strong>に関する許諾です。市販CDや公式MVの音源をそのまま配信で流すと<strong>原盤権侵害（アカウントBANリスク）</strong>になります。必ず表内のリンクより「歌枠用カラオケ音源」または「自作伴奏」をご使用ください。</p>
      </section>

      <!-- データテーブル -->
      <div class="table-wrapper">
        {songs.length === 0 ? (
          <div class="empty-state">現在表示可能なデータがありません。次回の自動バッチ処理（毎日24:00実行）をお待ちください。</div>
        ) : (
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">1. トレンド動画</th>
                <th scope="col" style="text-align: right;">2. 再生数 / 反応率</th>
                <th scope="col">3. 著作権（作詞・作曲）</th>
                <th scope="col">4. 原盤権（音源）</th>
                <th scope="col">5. 情報源 / 期限</th>
              </tr>
            </thead>
            <tbody>
              {songs.map(song => (
                <tr>
                  {/* 1. トレンド動画 */}
                  <td>
                    {song.video_url ? (
                      <a href={song.video_url} target="_blank" rel="noopener noreferrer" class="song-title-link">
                        <strong class="song-title">▶ {song.title}</strong>
                      </a>
                    ) : (
                      <strong class="song-title">{song.title}</strong>
                    )}
                    <br />
                    <span class="song-meta">{song.artist} ({song.pub_date || '不明'} / {getSeasonTag(song.pub_date)})</span>
                  </td>
                  {/* 2. 再生数 / 反応率 */}
                  <td class="metrics-cell">
                    <strong>{(song.metrics?.views ?? 0).toLocaleString()} 回再生</strong><br />
                    <span class="engagement-pill">📈 {song.metrics?.engagement_rate ?? 0}%</span>
                    {song.metrics_history && song.metrics_history.length > 1 && (
                      <div class="mini-trend">
                        <span class="mini-trend-label">📅 {song.metrics_history.length}日分記録</span>
                      </div>
                    )}
                  </td>
                  {/* 3. 著作権（作詞・作曲） */}
                  <td>
                    <span class={`badge ${getBadgeClass(song.rights_status)}`}>{song.rights_status}</span><br />
                    <span class="sub-text">コード: <code>{song.jasrac_code}</code></span><br />
                    <span class="sub-text">検索名: <code>{song.jasrac_search_title || song.title}</code> / <code>{song.jasrac_search_artist || song.artist}</code></span>
                  </td>
                  {/* 4. 原盤権（音源） */}
                  <td>
                    {song.karaoke_search_url ? (
                      <a href={song.karaoke_search_url} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">
                        🎤 歌枠用音源を探す
                      </a>
                    ) : (
                      <span class="sub-text">要自作伴奏</span>
                    )}
                  </td>
                  {/* 5. 情報源 / 期限 */}
                  <td>
                    <a href={song.source_url} target="_blank" rel="noopener noreferrer" class="link-primary">{song.source_name}</a><br />
                    <span class="sub-text text-danger">期限: {song.valid_until}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <!-- API案内 -->
      <section class="card api-card">
        <h2>🔌 REST API エンドポイント</h2>
        <p>JASRAC検索名・一次ソースURL・確認期限を含む構造化データセットは、API経由で直接取得可能です。</p>
        <div class="api-endpoints">
          <div class="api-row">
            <code class="api-method">GET</code>
            <code class="api-path">/api/v1/songs.json</code>
            <span class="api-desc">最新トレンドソング一覧 (metrics_history, raw_youtube 含む)</span>
          </div>
          <div class="api-row">
            <code class="api-method">GET</code>
            <code class="api-path">/api/v1/history.json</code>
            <span class="api-desc">日次スナップショット履歴インデックス</span>
          </div>
        </div>
      </section>

      <!-- 推奨機材（アフィリエイト） -->
      <section class="card affiliate-card">
        <h3>🎧 配信・音響制作の推奨機材</h3>
        <p>トレンド楽曲のカバー制作や高音質プラットフォーム配信を行うクリエイター向けの推奨機材一覧。</p>
        <div class="affiliate-grid">
          {affiliateItems.map(item => (
            <div class="affiliate-item">
              <h4>{item.title}</h4>
              <p>{item.desc}</p>
              <a href={item.url} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-outline">仕様を見る (外部サイト)</a>
            </div>
          ))}
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <p>【免責事項】当データは、検証時点における公開APIおよびレジストリ等から機械的に集約・推計したものです。権利許諾状況は変動する可能性があるため、商用利用の際は必ず各権利団体（JASRAC/NexTone等）の公式ポータルにて個別確認を行ってください。</p>
    </footer>

  </body>
</html>

<!-- Chart.js グラフ初期化スクリプト -->
<script define:vars={{ chartData, historyDates }}>
  const PALETTE = [
    '#6366f1','#f59e0b','#10b981','#ef4444','#3b82f6',
    '#8b5cf6','#ec4899','#14b8a6','#f97316','#a3e635'
  ];

  const songs = JSON.parse(chartData);
  const allDates = JSON.parse(historyDates);

  // song-filter を動的に構築
  const songFilter = document.getElementById('song-filter');
  songs.forEach((s, i) => {
    const opt = document.createElement('option');
    opt.value = String(i);
    opt.textContent = `${s.title} (${s.artist})`;
    songFilter.appendChild(opt);
  });

  function getMetricLabel(metric) {
    const labels = {
      views: '再生数',
      engagement_rate: 'エンゲージメント率 (%)',
      daily_views: '日速',
      likes: 'いいね数'
    };
    return labels[metric] || metric;
  }

  function buildDatasets(metric, songIndexFilter) {
    const targetSongs = songIndexFilter === 'all' ? songs : [songs[parseInt(songIndexFilter)]];
    return targetSongs.map((s, i) => {
      const color = PALETTE[i % PALETTE.length];
      const dataMap = {};
      (s.history || []).forEach(h => { dataMap[h.date] = h[metric] ?? null; });
      return {
        label: `${s.title}`,
        data: allDates.map(d => dataMap[d] ?? null),
        borderColor: color,
        backgroundColor: color + '22',
        borderWidth: 2.5,
        pointRadius: 5,
        pointHoverRadius: 8,
        tension: 0.35,
        fill: false,
        spanGaps: true
      };
    });
  }

  const ctx = document.getElementById('trendChart').getContext('2d');
  let currentMetric = 'views';
  let currentFilter = 'all';

  const chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: allDates,
      datasets: buildDatasets(currentMetric, currentFilter)
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            font: { family: "'Inter', 'Noto Sans JP', sans-serif", size: 12 },
            color: '#e2e8f0',
            boxWidth: 14,
            padding: 16
          }
        },
        tooltip: {
          backgroundColor: 'rgba(15,23,42,0.92)',
          titleColor: '#94a3b8',
          bodyColor: '#e2e8f0',
          borderColor: '#334155',
          borderWidth: 1,
          padding: 12,
          callbacks: {
            label: ctx => {
              const v = ctx.parsed.y;
              if (v === null) return `${ctx.dataset.label}: データなし`;
              if (currentMetric === 'views' || currentMetric === 'daily_views' || currentMetric === 'likes') {
                return `${ctx.dataset.label}: ${v.toLocaleString()}`;
              }
              return `${ctx.dataset.label}: ${v}%`;
            }
          }
        }
      },
      scales: {
        x: {
          grid: { color: '#1e293b' },
          ticks: { color: '#94a3b8', font: { size: 12 } }
        },
        y: {
          grid: { color: '#1e293b' },
          ticks: {
            color: '#94a3b8',
            font: { size: 12 },
            callback: v => {
              if (currentMetric === 'engagement_rate') return v + '%';
              return v >= 1000000 ? (v/1000000).toFixed(1) + 'M' : v >= 1000 ? (v/1000).toFixed(0) + 'K' : v;
            }
          },
          title: {
            display: true,
            text: getMetricLabel(currentMetric),
            color: '#64748b',
            font: { size: 12 }
          }
        }
      }
    }
  });

  function updateChart() {
    chart.data.datasets = buildDatasets(currentMetric, currentFilter);
    chart.options.scales.y.title.text = getMetricLabel(currentMetric);
    chart.update('active');
  }

  document.getElementById('metric-selector').addEventListener('change', e => {
    currentMetric = e.target.value;
    updateChart();
  });

  document.getElementById('song-filter').addEventListener('change', e => {
    currentFilter = e.target.value;
    updateChart();
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    font-family: 'Inter', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.65;
    color: #e2e8f0;
    background: #0f172a;
    margin: 0;
  }

  /* ===== HEADER ===== */
  .site-header {
    background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 50%, #1e293b 100%);
    border-bottom: 1px solid #334155;
    padding: 40px 24px 32px;
    text-align: center;
  }
  .header-inner { max-width: 900px; margin: 0 auto; }
  .site-header h1 { margin: 0 0 8px; font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 700; color: #f1f5f9; letter-spacing: -0.02em; }
  .site-header p { margin: 0 0 18px; color: #94a3b8; font-size: 0.9rem; }
  .header-badges { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .hbadge {
    background: rgba(99,102,241,0.15);
    border: 1px solid rgba(99,102,241,0.3);
    color: #a5b4fc;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* ===== LAYOUT ===== */
  .main-container { max-width: 1280px; margin: 0 auto; padding: 28px 20px 60px; }

  /* ===== NAV ===== */
  .nav-links { display: flex; gap: 10px; margin-bottom: 28px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 20px; text-decoration: none; border-radius: 8px;
    font-weight: 600; font-size: 0.88rem; transition: all 0.2s ease;
    cursor: pointer;
    &:hover { transform: translateY(-1px); }
  }
  .btn-sm { padding: 6px 12px; font-size: 0.8rem; }
  .btn-primary { background: linear-gradient(135deg,#6366f1,#4f46e5); color: #fff; box-shadow: 0 4px 15px rgba(99,102,241,0.3); }
  .btn-success { background: linear-gradient(135deg,#059669,#047857); color: #fff; box-shadow: 0 4px 15px rgba(5,150,105,0.3); }
  .btn-outline { border: 1px solid #334155; color: #94a3b8; background: transparent; &:hover { border-color: #6366f1; color: #a5b4fc; } }

  /* ===== CARDS ===== */
  .card {
    margin-bottom: 24px; padding: 22px 24px; border-radius: 12px;
    background: #1e293b; border: 1px solid #334155;
  }

  /* ===== CHART SECTION ===== */
  .chart-section { background: linear-gradient(135deg, #1e293b 0%, #162032 100%); }
  .chart-header { margin-bottom: 20px; }
  .chart-header h2 { margin: 0 0 6px; font-size: 1.15rem; color: #f1f5f9; font-weight: 700; }
  .chart-subtitle { margin: 0; color: #64748b; font-size: 0.85rem; }
  .chart-controls {
    display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap;
  }
  .control-group { display: flex; flex-direction: column; gap: 6px; }
  .control-group label { font-size: 0.8rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.06em; }
  .chart-select {
    background: #0f172a; border: 1px solid #334155; color: #e2e8f0;
    padding: 8px 12px; border-radius: 8px; font-size: 0.88rem;
    font-family: inherit; cursor: pointer;
    min-width: 200px;
    &:focus { outline: none; border-color: #6366f1; }
  }
  .chart-wrapper {
    background: #0f172a;
    border-radius: 10px;
    padding: 20px;
    border: 1px solid #1e293b;
    margin-bottom: 16px;
    height: 340px;
    position: relative;
  }
